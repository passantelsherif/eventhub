FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy both the app package AND job.py — one image, two entrypoints
COPY app/ ./app/
COPY job.py .

EXPOSE 8085

HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8085/health')" || exit 1

# Default = run the API server
# Override at runtime with: podman run --rm analytics-api:local python job.py
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8085"]
